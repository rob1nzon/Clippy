diff --git a/.github/workflows/release.yml b/.github/workflows/release.yml
new file mode 100644
index 0000000..c84eea5
--- /dev/null
+++ b/.github/workflows/release.yml
@@ -0,0 +1,173 @@
+name: Build and Release
+
+on:
+  release:
+    types: [created, published]
+  push:
+    tags:
+      - '*'
+  workflow_dispatch:
+    inputs:
+      tag:
+        description: 'Tag to release'
+        required: true
+        type: string
+
+permissions:
+  contents: write
+
+jobs:
+  build-and-release:
+    runs-on: windows-2022
+    
+    strategy:
+      matrix:
+        platform: [x64, x86, arm64]
+    
+    env:
+      Solution_Name: Clippy.sln
+      Configuration: Release
+      
+    steps:
+    - name: Checkout code
+      uses: actions/checkout@v4
+      with:
+        submodules: recursive
+        fetch-depth: 0
+      
+    - name: Patch App.xaml.cs to remove Tray dependency
+      shell: pwsh
+      run: |
+        $appXamlCs = "Clippy\App.xaml.cs"
+        if (Test-Path $appXamlCs) {
+          Write-Host "Reading App.xaml.cs..."
+          $content = Get-Content $appXamlCs -Raw
+          
+          # Comment out using Clippy.Tray
+          $content = $content -replace '(\s*using Clippy\.Tray;)', '        // $1  // Patched: Tray not available'
+          
+          # Comment out TrayFlyoutWindow declarations and usage
+          $content = $content -replace '(.*TrayFlyoutWindow.*)', '        // $1  // Patched: Tray not available'
+          
+          Set-Content $appXamlCs -Value $content -NoNewline
+          Write-Host "✓ Patch applied successfully"
+        } else {
+          Write-Host "✗ App.xaml.cs not found!"
+          exit 1
+        }
+        
+    - name: Setup .NET
+      uses: actions/setup-dotnet@v4
+      with:
+        dotnet-version: '8.0.x'
+        
+    - name: Add MSBuild to PATH
+      uses: microsoft/setup-msbuild@v2
+      with:
+        msbuild-architecture: x64
+    
+    - name: Add CommunityToolkit Labs NuGet source
+      run: |
+        dotnet nuget add source https://pkgs.dev.azure.com/dotnet/CommunityToolkit/_packaging/CommunityToolkit-Labs/nuget/v3/index.json --name CommunityToolkit-Labs
+      
+    - name: Restore NuGet packages
+      run: nuget restore $env:Solution_Name -Source "https://api.nuget.org/v3/index.json;https://pkgs.dev.azure.com/dotnet/CommunityToolkit/_packaging/CommunityToolkit-Labs/nuget/v3/index.json"
+      
+    - name: Restore dependencies
+      run: dotnet restore $env:Solution_Name
+    
+    - name: Build MSIX Package for ${{ matrix.platform }}
+      shell: pwsh
+      run: |
+        Write-Host "Building MSIX package for ${{ matrix.platform }}..."
+        
+        $platform = "${{ matrix.platform }}"
+        $appPackageDir = "$env:GITHUB_WORKSPACE\AppPackages\$platform\"
+        
+        msbuild Clippy\Clippy.csproj `
+          /t:Build,Publish `
+          /p:Configuration=$env:Configuration `
+          /p:Platform=$platform `
+          /p:UapAppxPackageBuildMode=SideloadOnly `
+          /p:AppxBundle=Never `
+          /p:AppxPackageDir="$appPackageDir" `
+          /p:AppxPackageSigningEnabled=false `
+          /p:GenerateAppxPackageOnBuild=true `
+          /verbosity:minimal
+          
+        if ($LASTEXITCODE -ne 0) {
+          Write-Host "Build failed with exit code $LASTEXITCODE"
+          exit $LASTEXITCODE
+        }
+        
+        Write-Host "Build completed successfully"
+      
+    - name: Find and prepare MSIX package
+      id: find_msix
+      shell: pwsh
+      run: |
+        $platform = "${{ matrix.platform }}"
+        Write-Host "Searching for MSIX package for $platform..."
+        
+        $msixFiles = Get-ChildItem -Path "AppPackages\$platform" -Recurse -Filter "*.msix" | Where-Object { $_.Name -notlike "*_Test*" }
+        
+        if ($msixFiles.Count -eq 0) {
+          Write-Host "No MSIX package found for $platform"
+          exit 1
+        }
+        
+        $msixFile = $msixFiles[0]
+        Write-Host "Found MSIX: $($msixFile.FullName)"
+        Write-Host "Size: $($msixFile.Length / 1MB) MB"
+        
+        # Create a clean filename for the release
+        $newName = "Clippy-$platform.msix"
+        $newPath = Join-Path $env:GITHUB_WORKSPACE $newName
+        Copy-Item $msixFile.FullName -Destination $newPath
+        
+        Write-Host "Copied to: $newPath"
+        
+        # Output for next step
+        "msix_path=$newPath" >> $env:GITHUB_OUTPUT
+        "msix_name=$newName" >> $env:GITHUB_OUTPUT
+      
+    - name: Upload MSIX to release
+      if: github.event_name == 'release' || github.event_name == 'push'
+      shell: pwsh
+      env:
+        GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
+      run: |
+        $msixPath = "${{ steps.find_msix.outputs.msix_path }}"
+        $msixName = "${{ steps.find_msix.outputs.msix_name }}"
+        
+        # Determine the tag name
+        if ("${{ github.event_name }}" -eq "release") {
+          $tag = "${{ github.event.release.tag_name }}"
+        } elseif ("${{ github.ref_type }}" -eq "tag") {
+          $tag = "${{ github.ref_name }}"
+        } else {
+          Write-Host "Not a release or tag event, skipping upload"
+          exit 0
+        }
+        
+        Write-Host "Uploading $msixName to release $tag..."
+        
+        # Check if release exists, if not create it
+        $releaseExists = gh release view $tag --repo rob1nzon/Clippy 2>&1
+        if ($LASTEXITCODE -ne 0) {
+          Write-Host "Release $tag does not exist, creating it..."
+          gh release create $tag --repo rob1nzon/Clippy --title $tag --notes "Release $tag"
+        }
+        
+        # Upload the asset
+        gh release upload $tag $msixPath --repo rob1nzon/Clippy --clobber
+        
+        Write-Host "✓ Successfully uploaded $msixName to release $tag"
+    
+    - name: Upload build artifacts (for workflow dispatch)
+      if: github.event_name == 'workflow_dispatch'
+      uses: actions/upload-artifact@v4
+      with:
+        name: Clippy-${{ matrix.platform }}-Release
+        path: ${{ steps.find_msix.outputs.msix_path }}
+        retention-days: 30
-- 
